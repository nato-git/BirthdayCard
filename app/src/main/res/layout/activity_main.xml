                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|start"
                    android:padding="5dp"
                    android:text="29"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textDay29Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:elevation="10dp"
                    android:textColor="#FF0000"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 30日 -->
            <FrameLayout
                android:id="@+id/containerDay30"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/day30"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|start"
                    android:padding="5dp"
                    android:text="30"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textDay30Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:elevation="10dp"
                    android:textColor="#FF0000"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 31日 -->
            <FrameLayout
                android:id="@+id/containerDay31"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/day31"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|start"
                    android:padding="5dp"
                    android:text="31"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textDay31Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:elevation="10dp"
                    android:textColor="#FF0000"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="10dp"
        android:background="@color/white"
        android:orientation="vertical"
        android:visibility="visible"
        android:id="@+id/edit">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:textSize="35sp"
            android:textColor="@color/black"
            android:id="@+id/monthday"
            android:text="1月1日"></TextView>
        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:background="@color/black"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"></View>
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_margin="15dp"></TextView>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="15dp"
            android:hint="名前を記入"
            android:id="@+id/new_name"></EditText>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="15dp"
            android:hint="タグを記入"
            android:id="@+id/new_tag"></EditText>
        <Button
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="追加する"
            android:textSize="20sp"
            android:layout_margin="15dp"
            android:id="@+id/add_button"></Button>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>